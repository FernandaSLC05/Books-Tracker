# Porta do servidor (Railway/Render definem automaticamente)
PORT=8080

# Banco de dados (o Spring detecta MySQL ou PostgreSQL automaticamente pela URL)
# Exemplo local (MySQL):
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/books_tracker?serverTimezone=UTC
# Exemplo producao (PostgreSQL no Neon):
# SPRING_DATASOURCE_URL=jdbc:postgresql://seu-host.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=sua_senha_do_banco

# Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Chave da Google Books API
GOOGLE_BOOKS_API_KEY=sua_chave_google_books

# URL do front-end em producao (ou * para liberar qualquer origem)
CORS_ALLOWED_ORIGINS=http://localhost:5173
